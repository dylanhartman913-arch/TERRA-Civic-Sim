# ── Raw and processed data ────────────────────────────────────────────────────
# All raw inputs and derived outputs live outside version control.
# See data/README.md for download instructions and notebook execution order.
data/raw/*
data/processed/*
# But preserve directory skeletons so `git clone` produces the expected layout.
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
node_modules/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
*.key
secrets/

# ── Large binary / domain-specific formats ────────────────────────────────────
# These can exceed 50 MB and should never be committed regardless of location.
*.parquet
*.arrow
*.graphml
*.jls          # Julia serialization (E4ST model_debug / data_parsed files, up to 500 MB)
*.zip
*.cpg          # Shapefile component
*.dbf          # Shapefile component
*.prj          # Shapefile component
*.sbn          # Shapefile component
*.sbx          # Shapefile component
*.shp          # Shapefile component
*.shx          # Shapefile component
*.shp.xml      # Shapefile component

# ── Large GeoJSON / HTML maps ─────────────────────────────────────────────────
# Individual files that exceed the 50 MB threshold even outside data/ dirs.
# Check `find . -size +50M` before committing new geo outputs.
data/processed/mw_huc8.geojson
data/processed/osm_transmission_hv.geojson
data/processed/combined_map.html
data/processed/HTML/
data/processed/figures/14_lmp_map.html

# ── Tracked build deliverables (excepted from data/processed/* blanket ignore) ──
# All files below are deterministic notebook outputs, under the 50 MB git threshold,
# and required by terra_engine.initialize_state() (called by every Python test).
# Parquet files (county_crosswalk, generators_with_costs, spatial_hierarchy_*,
# synthetic_plant_assignments) remain untracked — blocked by global *.parquet rule.
!data/processed/county_climate_projections.json
!data/processed/synthetic_buses.geojson
!data/processed/synthetic_branches.geojson
!data/processed/ba_interchange_summary.csv
!data/processed/county_housing_baseline.json
!data/processed/county_ees_baseline.json
!data/processed/lifecycle_coefficients.json
!data/processed/mw_action_library_v3.json
!data/processed/mw_county_cards.json
!data/processed/mw_county_ees_summary.csv
!data/processed/mw_ecoregion_ees_summary.csv
# mw_ecoregions.geojson (11MB) — excluded: OneDrive re-upload during git-add
# blocked Python f.read() on the file. Leave untracked; regenerate from nb08.
!data/processed/mw_scenario_profiles.json
!data/processed/wy_county_fiscal_baseline.json
!data/processed/wy_fiscal_coefficients.json
!data/processed/wy_county_ag_baseline.json
!data/processed/wy_county_ag_engine_baseline.json
!data/processed/network_metadata.json
!data/processed/wy_grazing_allotments.csv
!data/processed/wy_ag_sources.csv
!data/processed/mc_validation_priority.csv
!data/processed/sweep_cost_ranking_sourced.csv
!data/processed/sweep_marginal_returns.csv
# county_crosswalk, generators_with_costs, synthetic_plant_assignments:
# required by initialize_state() / _build_fuel_mix_map() (terra_engine.py:602).
# Excepted here (after *.parquet rule) so negation wins.
# 119 KB, 12 KB, 245 KB — small enough to track without LFS.
# Regenerate from nb05 (crosswalk), nb11 (generators_with_costs), nb12 (plant_assignments).
!data/processed/county_crosswalk.parquet
!data/processed/generators_with_costs.parquet
!data/processed/synthetic_plant_assignments.parquet

# ── Notebooks with embedded large outputs ────────────────────────────────────
notebooks/14_e4st_results.ipynb

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/
env/

# ── Julia ─────────────────────────────────────────────────────────────────────
julia/Manifest.toml

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/settings.json
*.swp
*.swo
.idea/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/.claude/
.claude/settings.local.json
